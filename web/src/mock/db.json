  "memories": [
    { "id": "mm1", "treeId": "t1", "personId": "p01", "authorId": "u1", "title": "The wedding of Mango and Mangosteen", "body": "They married in the spring of 1958 at the house in Hội An that is still standing. There was no photographer, so nobody in the family knows what Mr. Mango wore.", "happenedAt": "1958-02-14", "photoUrl": null, "visibility": "TREE", "createdAt": "2026-09-04T14:00:00.000Z" },
    { "id": "mm2", "treeId": "t1", "personId": "p03", "authorId": "u2", "title": "Lunar New Year 2005", "body": "The last year all three siblings were under one roof at once. Jack Fruitson cooked; Peachy Chan complained about the fish.", "happenedAt": "2005-02-09", "photoUrl": null, "visibility": "TREE", "createdAt": "2026-09-04T14:10:00.000Z" },
    { "id": "mm3", "treeId": "t1", "personId": "p01", "authorId": "u1", "title": "What Mr. Mango said about the years after 1975", "body": "Written down from a conversation in 2008. Private for now — I want the family to agree on what to publish before it goes to everyone.", "happenedAt": "2008-06-11", "photoUrl": null, "visibility": "PRIVATE", "createdAt": "2026-09-04T14:20:00.000Z" },
    { "id": "mm4", "treeId": "t1", "personId": "p09", "authorId": "u2", "title": "Sokuntheary's first day of school", "body": "He refused to let go of the gate until his mother promised to come back at noon.", "happenedAt": "1991-09-01", "photoUrl": null, "visibility": "PRIVATE", "createdAt": "2026-09-04T14:30:00.000Z" },
    { "id": "mm5", "treeId": "t1", "personId": "p07", "authorId": "u1", "title": "The workshop", "body": "No date on this one — it belongs to no particular year. The bench by the window was moved twice and is still there.", "happenedAt": null, "photoUrl": null, "visibility": "TREE", "createdAt": "2026-09-04T14:40:00.000Z" },
    { "id": "mm6", "treeId": "t1", "personId": "p19", "authorId": "u2", "title": "Fig swam the whole length", "body": "District gala. He came third and was more pleased about the ribbon than the placing.", "happenedAt": "2024-07-21", "photoUrl": null, "visibility": "TREE", "createdAt": "2026-09-04T14:50:00.000Z" }
  ]
