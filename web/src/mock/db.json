  "people": [
    { "id": "p01", "treeId": "t1", "fullName": "Mr. Mango", "nickname": "Mango", "gender": "MALE", "birthDate": "1935-03-12", "deathDate": "2010-08-04", "isLiving": false, "photoUrl": null, "bio": "Founder of the family record. Fisherman on the river near Hội An until 1975, then a mechanic in the city for thirty years.", "createdById": "u1", "createdAt": "2026-09-01T09:00:00.000Z" },
    { "id": "p02", "treeId": "t1", "fullName": "Mrs. Mangosteen", "nickname": "Mangosteen", "gender": "FEMALE", "birthDate": "1938-11-02", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Married into the family in 1958 and kept the household accounts for six decades. Still writes every birthday card by hand.", "createdById": "u1", "createdAt": "2026-09-01T09:05:00.000Z" },

    { "id": "p03", "treeId": "t1", "fullName": "Jack Fruitson", "nickname": "Jack", "gender": "MALE", "birthDate": "1960-05-19", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Eldest of the three. Teacher of mathematics for twenty-eight years.", "createdById": "u1", "createdAt": "2026-09-01T09:10:00.000Z" },
    { "id": "p04", "treeId": "t1", "fullName": "Cherry Berry", "nickname": "Cherry", "gender": "FEMALE", "birthDate": "1962-01-25", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "No parents recorded in this tree — she married into it — so her generation is taken from her husband. Nurse at the provincial hospital in Hội An.", "createdById": "u1", "createdAt": "2026-09-01T09:15:00.000Z" },
    { "id": "p05", "treeId": "t1", "fullName": "Sir Watermelon", "nickname": "Watermelon", "gender": "FEMALE", "birthDate": "1963-09-08", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Kept the family photographs after 1990, which is most of where these dates come from.", "createdById": "u1", "createdAt": "2026-09-01T09:20:00.000Z" },
    { "id": "p06", "treeId": "t1", "fullName": "Coco Nutley", "nickname": "Coco", "gender": "MALE", "birthDate": "1961-07-14", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": null, "createdById": "u1", "createdAt": "2026-09-01T09:25:00.000Z" },
    { "id": "p07", "treeId": "t1", "fullName": "Peachy Chan", "nickname": "Peachy", "gender": "MALE", "birthDate": "1967-02-21", "deathDate": "2019-12-30", "isLiving": false, "photoUrl": null, "bio": "Ran the workshop on the corner. His tools passed to his son's generation.", "createdById": "u1", "createdAt": "2026-09-01T09:30:00.000Z" },
    { "id": "p08", "treeId": "t1", "fullName": "Dr. Pine Apple", "nickname": "Pine", "gender": "FEMALE", "birthDate": "1969-06-17", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Keeps the garden that the whole street uses cuttings from.", "createdById": "u1", "createdAt": "2026-09-01T09:35:00.000Z" },

    { "id": "p09", "treeId": "t1", "fullName": "Chheng Sokuntheary", "nickname": "Sokuntheary", "gender": "MALE", "birthDate": "1985-04-03", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Eldest grandchild. Kept the workshop going until 2021.", "createdById": "u2", "createdAt": "2026-09-02T11:00:00.000Z" },
    { "id": "p10", "treeId": "t1", "fullName": "Papaya Parker", "nickname": "Papaya", "gender": "FEMALE", "birthDate": "1988-10-12", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Accounts manager. The one who remembers every date in this tree.", "createdById": "u2", "createdAt": "2026-09-02T11:05:00.000Z" },
    { "id": "p11", "treeId": "t1", "fullName": "Grape Gatsby", "nickname": "Grape", "gender": "MALE", "birthDate": "1987-08-27", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "From the Nutley side of the family by his father. Build engineer.", "createdById": "u2", "createdAt": "2026-09-02T11:10:00.000Z" },
    { "id": "p12", "treeId": "t1", "fullName": "Lychee Min", "nickname": "Lychee", "gender": "FEMALE", "birthDate": "1992-12-05", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Started recording the family history on paper in 2019; this tree is that notebook, typed up.", "createdById": "u2", "createdAt": "2026-09-02T11:15:00.000Z" },
    { "id": "p13", "treeId": "t1", "fullName": "Durian Gray", "nickname": "Durian", "gender": "MALE", "birthDate": "1984-03-30", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "No parents recorded in this tree — married to Papaya Parker — so he sits in her generation rather than at the top.", "createdById": "u2", "createdAt": "2026-09-02T11:20:00.000Z" },
    { "id": "p14", "treeId": "t1", "fullName": "Pomelo Anderson", "nickname": "Pomelo", "gender": "FEMALE", "birthDate": null, "deathDate": null, "isLiving": true, "photoUrl": null, "bio": null, "createdById": "u2", "createdAt": "2026-09-02T11:25:00.000Z" },
    { "id": "p15", "treeId": "t1", "fullName": "Rambutan Reynolds", "nickname": "Rambutan", "gender": "MALE", "birthDate": "1990-09-19", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Photographer; most of the pictures in this tree are his.", "createdById": "u2", "createdAt": "2026-09-02T11:30:00.000Z" },
    { "id": "p16", "treeId": "t1", "fullName": "Miss Passion Fruit", "nickname": "Passion", "gender": "FEMALE", "birthDate": "1986-07-07", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Married to Chheng Sokuntheary. Paediatrician.", "createdById": "u2", "createdAt": "2026-09-02T11:35:00.000Z" },
    { "id": "p17", "treeId": "t1", "fullName": "Orange You Glad", "nickname": "Orange", "gender": "MALE", "birthDate": "1991-02-11", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": null, "createdById": "u2", "createdAt": "2026-09-02T11:40:00.000Z" },

    { "id": "p18", "treeId": "t1", "fullName": "Avocadbro", "nickname": "Avocado", "gender": "FEMALE", "birthDate": "2019-05-15", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "The youngest of the fourth generation recorded so far.", "createdById": "u2", "createdAt": "2026-09-02T11:45:00.000Z" },
    { "id": "p19", "treeId": "t1", "fullName": "Fig Newton", "nickname": "Fig", "gender": "MALE", "birthDate": "2012-01-09", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Swims for the district team.", "createdById": "u2", "createdAt": "2026-09-02T11:50:00.000Z" },
    { "id": "p20", "treeId": "t1", "fullName": "Manguito Bandito", "nickname": "Manguito", "gender": "FEMALE", "birthDate": "2015-06-23", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": null, "createdById": "u2", "createdAt": "2026-09-02T11:55:00.000Z" },
    { "id": "p21", "treeId": "t1", "fullName": "Blue Barry", "nickname": "Blue", "gender": "MALE", "birthDate": "2014-03-02", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Asks about the workshop tools every visit.", "createdById": "u2", "createdAt": "2026-09-02T12:00:00.000Z" },
    { "id": "p22", "treeId": "t1", "fullName": "Plum Diesel", "nickname": "Plum", "gender": "MALE", "birthDate": "2020-11-30", "deathDate": null, "isLiving": true, "photoUrl": null, "bio": "Born during the closure; has met his great-grandmother's photographs before the rest of the branch.", "createdById": "u2", "createdAt": "2026-09-02T12:05:00.000Z" },
