# Local development values for `docker compose` — copy to `.env`.
#
# `.env` is gitignored; this file is the one that gets committed, and every
# value below is a placeholder or a dev credential the compose file already
# defaults to. Nothing here is a secret: the real one lives in your own
# `.env`, which never leaves your machine.
#
# Every variable is optional — `docker compose up` works with none of them
# set. They exist so one value can be changed instead of editing the compose
# file.

# --- database ---------------------------------------------------------------
# Also the credentials the API's DATABASE_URL is built from inside the stack.
POSTGRES_USER=puong
POSTGRES_PASSWORD=puong_dev_password
POSTGRES_DB=puong

# Host port PostgreSQL is published on. Raised above 5432 on the machine this
# project was built on, because a local PostgreSQL already owned the default.
POSTGRES_PORT=5432

# --- api --------------------------------------------------------------------
# Host port the API is published on, and the port it listens on in-container.
API_PORT=3000
PORT=3000

# Origins allowed to call the API directly (anything that goes through nginx
# is same-origin and never needs it). The default matches the web tier.
CORS_ORIGIN=http://localhost:8080

# Signs the session cookie. Change it before this leaves your machine —
# rotating it signs everybody out, which is the intended response to a leak.
JWT_SECRET=replace-me-before-this-leaves-your-machine

# `Secure` on the session cookie. Must stay false while the stack serves
# plain http (a Secure cookie is dropped there and every request loses its
# session); docker-compose.tls.yml turns it on for you.
COOKIE_SECURE=false

# Believe X-Forwarded-For only when nginx is the only way in — which is what
# docker-compose.yml sets, since the API is behind the proxy there.
TRUST_PROXY=true

# Where photographs are written. A named volume is mounted over it in the
# container so uploads survive a rebuild.
UPLOAD_DIR=uploads

# --- web --------------------------------------------------------------------
# Host port nginx serves the SPA on (plain http).
WEB_PORT=8080

# Host port for https, used by docker-compose.tls.yml. It also names the port
# the plain-http server redirects to, so one variable moves both ends.
WEB_TLS_PORT=8443
