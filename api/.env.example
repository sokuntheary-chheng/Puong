# Local development values — copy to `.env` and change them.
# `.env` is gitignored; this file is the one that gets committed.

# PostgreSQL. In Docker this is provided by the `db` service in
# docker-compose.yml; locally it is the PostgreSQL 16 running in WSL.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/puong?schema=public"

# The port the API listens on.
PORT=3000

# Where the browser app is served from during development, so the API's CORS
# policy can name it exactly instead of allowing every origin.
CORS_ORIGIN="http://localhost:5173"

# Signs the session cookie issued from M3 onwards. Rotating this value signs
# everybody out, which is the intended behaviour when a token is suspected.
JWT_SECRET="replace-me-with-a-long-random-string"

# Adds the `Secure` attribute to the session cookie (`puong_session`), so the
# browser will only send it over https. Leave it false on http://localhost —
# a Secure cookie is dropped by the browser on a plain-http origin, and every
# request would then arrive without a session. Turn it on wherever the API is
# reached over TLS.
COOKIE_SECURE=false

# Trust the `X-Forwarded-For` header when working out who is calling, which is
# what every rate limit is counted by. Leave it false when the API can be
# reached directly — otherwise a client chooses its own key and walks past the
# limit. Turn it on only when a reverse proxy (nginx) is the only way in;
# docker-compose.yml sets it for exactly that reason.
TRUST_PROXY=false
