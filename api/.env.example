# Local development values — copy to `.env` and change them.
# `.env` is gitignored; this file is the one that gets committed.

# PostgreSQL. In Docker this is provided by the `db` service in
# docker-compose.yml; locally it is the PostgreSQL 16 running in WSL.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/puong?schema=public"

# The port the API listens on.
PORT=3000

# Where the browser app is served from during development, so the API's CORS
# policy can name it exactly instead of allowing every origin.
CORS_ORIGIN="http://localhost:5173"

# Signs the access tokens issued from M3 onwards. Rotating this value signs
# everybody out, which is the intended behaviour when a token is suspected.
JWT_SECRET="replace-me-with-a-long-random-string"
