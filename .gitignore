wind/

# Dependencies
node_modules/

# Build output
dist/
coverage/

# Secrets — commit .env.example with placeholder values instead
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Playwright output from e2e/
test-results/
playwright-report/

# Bundles produced by web's scripts/check-modules.mjs
.checks/

# Uploaded photographs and other user files — the *data* directory the API
# writes to (UPLOAD_DIR). The pattern matches that name at any depth on
# purpose, which is also why it needs the exception below: the NestJS module
# that serves those files lives at api/src/uploads/ and is source code. The
# first version of this line had no exception, so git never tracked the
# module, the repository did not compile from a clean checkout, and every
# CI build failed on `Cannot find module './uploads/uploads.module'`.
uploads/
!api/src/uploads/

# TLS certificates — generated on first start, or dropped in by hand
certs/
